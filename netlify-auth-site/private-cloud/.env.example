# Generate separate keys locally with `openssl rand -hex 32` for APP_ANON_KEY, ARVIO_AUTH_SECRET, and ARVIO_BLOB_ENCRYPTION_KEY.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
ARVIO_AUTH_SECRET=replace-with-at-least-64-random-characters
ARVIO_BLOB_ENCRYPTION_KEY=replace-with-64-hex-characters
APP_ANON_KEY=replace-with-64-hex-characters

# Optional provider credentials for the corresponding private Cloud proxies.
TMDB_API_KEY=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=

# Optional transactional email for password reset/setup links.
RESEND_API_KEY=
AUTH_EMAIL_FROM=ARVIO Private Cloud <noreply@example.net>
SITE_URL=https://auth.example.net
ARVIO_WEB_ORIGIN=https://arvio.example.net
TV_AUTH_VERIFY_BASE_URL=https://auth.example.net
DISCORD_AUTH_VERIFY_BASE_URL=https://auth.example.net

# Optional tuning.
ARVIO_DB_POOL_MAX=6
ARVIO_MAX_BODY_BYTES=5242880

# SIMKL + WeTrakr account-level credential coordinator
# Generate with: openssl rand -base64 32
ARVIO_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
SIMKL_V2_CLIENT_ID=REPLACE_WITH_SIMKL_V2_CLIENT_ID
WETRAKR_CLIENT_ID=REPLACE_WITH_WETRAKR_API_KEY
