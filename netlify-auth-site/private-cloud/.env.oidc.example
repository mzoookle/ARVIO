# Keycloak OIDC configuration. Set the client secret only in the API service.
ARVIO_OIDC_ISSUER=https://auth.example.net/realms/exampleRealm
ARVIO_OIDC_CLIENT_ID=arvio
ARVIO_OIDC_CLIENT_SECRET=REPLACE_IN_SECRET_STORE
ARVIO_OIDC_REDIRECT_URI=https://arvio-auth.example.net/oidc/callback
ARVIO_OIDC_SCOPES=openid email profile groups
# Exact Web origin; this is already used by the private cloud CORS configuration.
ARVIO_WEB_ORIGIN=https://watch.example.net
ARVIO_AUTH_PORTAL_ORIGIN=https://arvio-auth.example.net

# Exact full Keycloak group path allowed to administer ARVIO
ARVIO_OIDC_ADMIN_GROUP=/arvio
